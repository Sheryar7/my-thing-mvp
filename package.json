{
  "name": "my-thing-mvp-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix my-thing-frontend",
    "dev:backend": "npm run start:dev --prefix my-thing-backend",
    "build:frontend": "npm run build --prefix my-thing-frontend",
    "build:backend": "npm run build --prefix my-thing-backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}