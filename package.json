{
  "name": "my-thing-mvp-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix my-thing-frontend run dev",
    "dev:backend": "npm --prefix my-thing-backend run start:dev",
    "build:frontend": "npm --prefix my-thing-frontend run build",
    "build:backend": "npm --prefix my-thing-backend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}