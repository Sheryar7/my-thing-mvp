# ==============================================================================
# Monorepo Root .gitignore - MyThing Platform
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Environment Variables & Secrets (Allow only .env.example templates)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.stage
*.env
*.env.local
!.env.example
!.env.*.example

# Production Build Outputs
dist/
build/
out/
.next/
/.vercel/
*.tsbuildinfo

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage Reports
coverage/
.nyc_output/

# Local Databases & State
*.sqlite
*.sqlite3
*.db
*.db-journal
*.rdb

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary & Cache Directories
.cache/
.temp/
.tmp/
.turbo/